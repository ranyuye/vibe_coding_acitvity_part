# 用于 Caddy 自动申请 HTTPS。只填写域名，不要带 https:// 或路径。
SITE_DOMAIN=vote.example.com

# 飞书登录
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace_on_server_only
FEISHU_REDIRECT_URI=https://vote.example.com/api/auth/callback
SESSION_SECRET=replace_with_at_least_32_random_characters

# 飞书多维表
FEISHU_BASE_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_WIKI_NODE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_WORKS_TABLE_ID=tblxxxxxxxxxxxxxxxx
FEISHU_VOTES_TABLE_ID=tblxxxxxxxxxxxxxxxx
FEISHU_CURRENT_ROUND=1

# 字段名与默认中文名一致时无需修改
FEISHU_FIELD_REGISTRATION_ID=报名ID
FEISHU_FIELD_WORK_NAME=作品名
FEISHU_FIELD_SUBMITTER=提交人
FEISHU_FIELD_SUBMITTED_AT=报名时间
FEISHU_FIELD_VIDEO_URL=提交视频链接
FEISHU_FIELD_WORK_URL=作品链接
FEISHU_FIELD_ROUND=当前比赛轮次
